      <defaultState blockSize="1024" stepSize="0" windowType="3">
        <parameters key="hopsize" value="1.0"/>
        <parameters key="model" value="0.0"/>
        <parameters key="windowsize" value="10.0"/>
      </defaultState>
      <parameters>
        <value identifier="model" name="Model" description="The model used to generate the embeddings"
               unit="" minValue="0.0" maxValue="5.0" defaultValue="0.0" isQuantized="1"
               quantizeStep="1.0">
          <valueNames value="1. CLAP2 Small (F16)"/>
          <valueNames value="2. CLAP2 XXS (F16)"/>
          <valueNames value="3. CLAP General (Q8_0)"/>
          <valueNames value="4. CLAP General (Q4_K_M)"/>
          <valueNames value="5. CLAP Music and Speech (Q8_0)"/>
          <valueNames value="6. CLAP Music and Speech (Q4_K_M)"/>
        </value>
      </parameters>
      <parameters>
        <value identifier="windowsize" name="Window Size" description="The duration of the analysis windows, in seconds"
               unit="s" minValue="1.0" maxValue="10.0" defaultValue="10.0" isQuantized="1"
               quantizeStep="0.5"/>
      </parameters>
      <parameters>
        <value identifier="hopsize" name="Hop Size" description="The duration between two analysis windows, in seconds (the computation time is proportional to the number of windows)"
               unit="s" minValue="0.1000000014901161" maxValue="10.0" defaultValue="1.0"
               isQuantized="1" quantizeStep="0.1000000014901161"/>
      </parameters>
      <output identifier="tag" name="Best Class" description="The most similar prompt of the audio window among all the levels of the hierarchical prompts, with its similarity score"
              unit="" hasFixedBinCount="1" binCount="0" hasKnownExtents="0"
              minValue="0.0" maxValue="0.0" isQuantized="0" quantizeStep="0.0"
              sampleType="2" sampleRate="0.0" hasDuration="1"/>
      <extraOutputs>
        <value identifier="similarity" name="Similarity" description="The similarity score of the tagged prompt"
               unit="" hasKnownExtents="1" minValue="0.0" maxValue="0.5" isQuantized="0"
               quantizeStep="0.0"/>
      </extraOutputs>
      <extraOutputs>
        <value identifier="probability" name="Probability" description="The probability of the tagged prompt"
               unit="" hasKnownExtents="1" minValue="0.0" maxValue="1.0" isQuantized="0"
               quantizeStep="0.0"/>
      </extraOutputs>
      <inputs>
        <value identifier="prompt" name="Prompt" description="The text prompts to compare with the audio, one marker per prompt (e.g. generated by the tools or the annotations of the host), the levels of the hierarchical prompts being separated by slashes (e.g. Animal/A bird sings./An owl hoots.)"
               unit="" hasFixedBinCount="1" binCount="0" hasKnownExtents="0"
               minValue="0.0" maxValue="0.0" isQuantized="0" quantizeStep="0.0"
               sampleType="2" sampleRate="0.0" hasDuration="0"/>
      </inputs>
    </description>
    <key identifier="ircamclap:clapprompt" feature="tag"/>
    <inputs key="prompt" value="de7e1f453b3b4270b63ec4b7b0be41bc"/>
    <state blockSize="1024" stepSize="0" windowType="3">
