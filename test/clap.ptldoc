  <tracks MiscModelVersion="196608" identifier="cb2c5bba98344175a745db951c1a2d59"
          name="CLAP Novelty - Novelty" useInputResultsExtraThresholds="1"
          sampleRate="44100.0" height="39" showInGroup="1" oscIdentifier=""
          sendViaOsc="0" zoomValueMode="2" zoomLogScale="0" zoomLink="1">
    <file path="" commit=""/>
    <fileDescription path="" format="0" extension="" csvHeaderType="0" reaperType="0"
                     columnSeparator="0" disableLabelEscaping="0" includeDescription="1"
                     sdifFrameSignature="????" sdifMatrixSignature="????"/>
    <description name="CLAP Novelty" inputDomain="0" maker="Ircam" version="1"
                 category="Segmentation" details="Detection of the changes in the audio stream using the audio embeddings of the CLAP and CLAP2 models of LAION, without text prompt nor example. At each boundary between two analysis windows, the plugin compares the average embedding of the windows entirely before the boundary with the average embedding of the windows entirely after the boundary, over the duration of the Context parameter. The windows shortened at the beginning and at the end of the audio stream are ignored, hence the novelty is zero (no change is considered) during approximately the window size at the beginning and at the end of the audio stream. The novelty is the cosine distance between the two embeddings, between 0 (the content does not change) and 2 (in practice, the audio embeddings remain similar and the novelty rarely exceeds 0.5). The boundaries are the peaks of the novelty, separated by at least the context duration, with the novelty as value (the boundaries can be filtered by the host according to this value). The features are generated at the end of the analysis."
                 copyright="CLAP and CLAP2 models by LAION. CLAP.cpp by Gorse. Clap Vamp Plugin by Pierre Guillot. Copyright 2026 Ircam. MIT License.">
      <defaultState blockSize="1024" stepSize="0" windowType="3">
        <parameters key="context" value="5.0"/>
        <parameters key="hopsize" value="1.0"/>
        <parameters key="model" value="0.0"/>
        <parameters key="windowsize" value="5.0"/>
      </defaultState>
      <parameters>
        <value identifier="model" name="Model" description="The model used to generate the embeddings"
               unit="" minValue="0.0" maxValue="5.0" defaultValue="0.0" isQuantized="1"
               quantizeStep="1.0">
          <valueNames value="1. CLAP2 Small (F16)"/>
          <valueNames value="2. CLAP2 XXS (F16)"/>
          <valueNames value="3. CLAP General (Q8_0)"/>
          <valueNames value="4. CLAP General (Q4_K_M)"/>
          <valueNames value="5. CLAP Music and Speech (Q8_0)"/>
          <valueNames value="6. CLAP Music and Speech (Q4_K_M)"/>
        </value>
      </parameters>
      <parameters>
        <value identifier="windowsize" name="Window Size" description="The duration of the analysis windows, in seconds"
               unit="s" minValue="1.0" maxValue="10.0" defaultValue="5.0" isQuantized="1"
               quantizeStep="0.5"/>
      </parameters>
      <parameters>
        <value identifier="hopsize" name="Hop Size" description="The duration between two analysis windows, in seconds (the computation time is proportional to the number of windows)"
               unit="s" minValue="0.1000000014901161" maxValue="10.0" defaultValue="1.0"
               isQuantized="1" quantizeStep="0.1000000014901161"/>
      </parameters>
      <parameters>
        <value identifier="context" name="Context" description="The duration compared before and after each boundary and the minimum duration between two detected boundaries, in seconds"
               unit="s" minValue="0.1000000014901161" maxValue="60.0" defaultValue="5.0"
               isQuantized="1" quantizeStep="0.1000000014901161"/>
      </parameters>
      <output identifier="novelty" name="Novelty" description="The novelty at each boundary between two analysis windows (the cosine distance between the average embeddings before and after the boundary, zero at the beginning and at the end of the audio stream)"
              unit="" hasFixedBinCount="1" binCount="1" hasKnownExtents="1"
              minValue="0.0" maxValue="0.300000011920929" isQuantized="0" quantizeStep="0.0"
              sampleType="2" sampleRate="0.0" hasDuration="0"/>
    </description>
    <key identifier="ircamclap:clapnovelty" feature="novelty"/>
    <state blockSize="1024" stepSize="0" windowType="3">
      <parameters key="context" value="1.0"/>
      <parameters key="hopsize" value="0.2000000029802322"/>
      <parameters key="model" value="7.0"/>
      <parameters key="windowsize" value="1.0"/>
    </state>
    <graphicsSettings font="Nunito Sans; 14.0 Regular" lineWidth="1.0" markerStyle="0">
      <colours map="7" background="0" foreground="ffff0000" duration="66000000"
               text="ff000000" shadow="0"/>
      <labelLayout position="12.0" justification="0"/>
    </graphicsSettings>
    <channelsLayout value="1"/>
    <valueZoom MiscModelVersion="196608" globalRange_start="0.0" globalRange_end="0.07129921764135361"
