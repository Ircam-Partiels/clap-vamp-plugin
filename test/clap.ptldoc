  <tracks MiscModelVersion="196608" identifier="3c7b46ce4d534244b77669c0ed91a216"
          name="CLAP Prompt Similarity Matrix" useInputResultsExtraThresholds="0"
          sampleRate="44100.0" height="42" showInGroup="1" oscIdentifier=""
          sendViaOsc="0" zoomValueMode="1" zoomLogScale="0" zoomLink="1">
    <file path="" commit=""/>
    <fileDescription path="" format="0" extension="" csvHeaderType="0" reaperType="0"
