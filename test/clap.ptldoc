               minimumLength="0.0" visibleRange_start="0.0" visibleRange_end="0.0">
      <grid MiscModelVersion="196608" tickReference="0.0" mainTickInterval="3"
            tickPowerBase="2.0" tickDivisionFactor="5.0"/>
